# Déjalo vacío para Railway o Netlify. En desarrollo, el frontend usa localhost:3000 por omisión.
VITE_API_URL=

# En producción, configura estas variables privadas en Railway o Netlify, no en VITE_*.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/ID_DE_IMPLEMENTACION/exec
GOOGLE_APPS_SCRIPT_TOKEN=token-configurado-en-Apps-Script

# Opcional: URL CSV publicada de Google Sheets.
# SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Configura estas variables privadas en Railway o Netlify para activar el asistente.
OPENAI_API_KEY=tu-clave-privada-de-openai
OPENAI_MODEL=gpt-6-luna
